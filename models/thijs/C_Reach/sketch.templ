// 1 | x x
// 0 | x x
// y _____
//   x 0 1

mdp

// can go in this direction
formula u = false;
formula r = x=0;
formula d = y=1;
formula l = false;

// target cell
formula goal = x=1 & y=0;

// updates of coordinates (if possible)
formula yu = u ? (y+1) : y;
formula xr = r ? (x+1) : x;
formula yd = d ? (y-1) : y;
formula xl = l ? (x-1) : x;


module clk
    // 0 - init, 1 - drive
    clk : [0..1] init 0;

    // random placement
    [place] clk=0 -> (clk'=1);
    
    // drive
    [up] 	clk=1 -> true;
    [right] clk=1 -> true;
    [down] 	clk=1 -> true;
    [left]  clk=1 -> true;
endmodule

module maze
	x : [0..1] init 0;
  y : [0..1] init 0;
	
	// initialisation
	[place] true ->
          1 :    (x'=0)&(y'=1);

	// moving around the maze (all combinations)
  [up]        true -> 1: (y'=yu);
  [right]     true -> 1: (x'=xr);
  [down]      true -> 1: (y'=yd);
  [left]      true -> 1: (x'=xl);
endmodule

// rewards
rewards "steps"
	clk=1: 1;
endrewards