// Example POMPD

// state space (value of variable "s")

//  0 - 1
//  |   |
//  2 - 3

dtmc

const int CMAX = 0;
//const double THRESHOLD;

// o=0 - observation in initial state
// o=1 - s0, s1 and s2
// o=2 - s3
// SELF_EXPLANATION: here an observation is a coloring, such that s0, s1 and s2 have the same color.
//                      comes into play in module maze below


// set to two bit memory by: hole int M_x_y in {0,1};
hole int M_0_1 in {0};
hole int M_0_2 in {0};
hole int M_1_1 in {0}; //inactive
hole int M_1_2 in {0}; //inactive

hole int P_0_1 in {2,3};
hole int P_0_2 in {3};
hole int P_1_1 in {2,3}; //inactive
hole int P_1_2 in {3};  //inactive

// SELF_EXPLANATION: choice_to_assignment (6,1) refers to the hole at index 6 (= P_1_1) 
//                      with assignment in the set of according options {2,3} at index 1 (= 3)


module actuator
    v : [0..4] init 0;

    //[steer_north] v = 0 -> 0.8: (v'=1) + 0.08: (v'=4) + 0.08: (v'=2) + 0.04: (v'=3);
    //[steer_east] v = 0 -> 0.8: (v'=2) + 0.08: (v'=1) + 0.08: (v'=3) + 0.04: (v'=4);
    //[steer_south] v = 0 -> 0.8: (v'=3) + 0.08: (v'=4) + 0.08: (v'=2) + 0.04: (v'=1);
    //[steer_west] v = 0 -> 0.8: (v'=4) + 0.08: (v'=1) + 0.08: (v'=3) + 0.04: (v'=2);

    [steer_north] v = 0 -> 1: (v'=1);
    [steer_east] v = 0 -> 1: (v'=2);
    [steer_south] v = 0 -> 1: (v'=3);
    [steer_west] v = 0 -> 1: (v'=4);

    [north] s != 4 & v = 1 -> (v'=0);
    [east] s != 4 & v = 2 -> (v'=0);
    [south] s != 4 & v = 3 -> (v'=0);
    [west] s != 4 & v = 4 -> (v'=0);
    [done] v != 0 -> (v'=0);

endmodule

module strategy
	pick : [0..4] init 0;
	mem : [0..1] init 0;
	[] v = 0 & pick = 0 & mem = 0 & o = 1 -> (mem'=M_0_1) & (pick'=P_0_1);
	[] v = 0 & pick = 0 & mem = 0 & o = 2 -> (mem'=M_0_2) & (pick'=P_0_2);

	[] v = 0 & pick = 0 & mem = 1 & o = 1 -> (mem'=M_1_1) & (pick'=P_1_1);
	[] v = 0 & pick = 0 & mem = 1 & o = 2 -> (mem'=M_1_2) & (pick'=P_1_2);

	[steer_north] pick=1 -> (pick'=0);
	[steer_east] pick=2 -> (pick'=0);
	[steer_south] pick=3 -> (pick'=0);
	[steer_west] pick=4 -> (pick'=0);
endmodule



module maze

	s : [0..5];
	o : [0..2];

	// initialisation
	[] s=0 -> 1 : (s'=1) & (o'=1);
           // + 1/4 : (s'=2) & (o'=1)
           // + 1/4 : (s'=3) & (o'=2)
           // + 1/4 : (s'=4) & (o'=2);

	// moving around the maze

	[east] s=1 -> (s'=2) & (o'=1);    // DIFF with G_Reach
	[west] s=1 -> (s'=1);
	[north] s=1 -> (s'=1);
	[south] s=1 -> (s'=3) & (o'=1);   

	[east] s=2 -> (s'=2);
	[west] s=2 -> (s'=1) & (o'=1);
	[north] s=2 -> (s'=2);
	[south] s=2 -> (s'=4) & (o'=2);

	[east] s=3 -> (s'=4) & (o'=2);
	[west] s=3 -> (s'=3);
	[north] s=3 -> (s'=2) & (o'=1);
	[south] s=3 -> (s'=3);

	// loop when we reach the target
	[done] s=4 -> true;

endmodule

module counter
    c : [0..CMAX] init 0;
    [east] true -> (c'=min(CMAX, c+1));
    [west] true -> (c'=min(CMAX, c+1));
    [north] true -> (c'=min(CMAX, c+1));
    [south] true -> (c'=min(CMAX, c+1));

endmodule

// reward structure (number of steps to reach the target)
rewards "steps"

	[east] true : 1;
	[west] true : 1;
	[north] true : 1;
	[south] true : 1;

endrewards

// target observation
label "goal" = s=4;
//label "traps" = s=11 | s=12;
